{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "moduleDetection": "legacy",
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "static/**/*.ts",
    "static/**/*.js",
    "static/types/*.d.ts"
  ],
  "exclude": ["node_modules", "build"]
}
