# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── VizCode caches & local state ────────────────────────────────────────────
.vizcode/
.local/
.local-tools/
*.log
scan_result_debug.json
# NOTE: root-anchored on purpose. A bare `parsers/` also matches `src/parsers/`
# and silently hid src/parsers/md_parser.py from git for months.
# (LESSONS.md #gitignored-fixture-dirs)
/parsers/

# ── AI secrets (API keys live here — NEVER commit) ──────────────────────────
ai/config.json
.env
.env.*
!.env.example

# ── Personal notes & experiments (local only) ───────────────────────────────
note/

# ── Frontend toolchain (Node) ───────────────────────────────────────────────
# build/ is intentionally NOT ignored: it holds the compiled .js that the app
# serves, committed so end-users run with zero Node install. Re-run `npm run
# build` after editing any static/*.ts and commit the regenerated build/.
node_modules/

# README/demo media
# Keep large videos in GitHub Releases or YouTube, not in the repository.
docs/videos/*.mp4
docs/videos/*.mov
docs/videos/*.webm
!docs/videos/.gitkeep
!docs/videos/README.md

# ── Claude Code personal/local settings (never commit) ──────────────────────
.claude/settings.local.json

# ── OS / IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
*.iml
