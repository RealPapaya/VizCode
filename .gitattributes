# Compiled frontend output (esbuild). Committed so end-users stay zero-install,
# but generated from static/*.ts|js — never hand-edit. These attributes keep the
# generated files out of diffs and auto-resolve merge conflicts in their favour
# (re-run `npm run build` after merging to regenerate).
build/** linguist-generated=true
build/** -diff
build/** merge=ours
# Treat build output as binary so core.autocrlf never rewrites line endings:
# esbuild always emits LF, the repo stores LF — without this, autocrlf=true users
# see every build/*.js as "modified" (CRLF in working tree) after each rebuild.
build/** -text
