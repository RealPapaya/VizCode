{
    "schema_rev":  1,
    "rules":  [
                  {
                      "id":  "VZS001",
                      "name":  "Hardcoded Secret",
                      "applies_to":  [
                                         "*"
                                     ],
                      "severity":  "high",
                      "keywords":  [
                                       "password",
                                       "passwd",
                                       "pwd",
                                       "secret",
                                       "api_key",
                                       "apikey",
                                       "token",
                                       "auth"
                                   ],
                      "pattern":  "(?i)(?:password|passwd|pwd|secret|api_key|apikey|token|auth)\\s*[=:]\\s*[\u0027\"]([^\u0027\"]{4,})[\u0027\"]",
                      "entropy_capture_group":  1,
                      "entropy_min":  2.5,
                      "deny_substrings_in_line":  [
                                                      "process.env",
                                                      "os.environ",
                                                      "getenv",
                                                      "config.",
                                                      "deno.env",
                                                      "import.meta.env"
                                                  ],
                      "allowlist_substrings":  [
                                                   "example",
                                                   "your-",
                                                   "your_",
                                                   "placeholder",
                                                   "changeme",
                                                   "xxxxxxxx",
                                                   "${",
                                                   "\u003ctoken\u003e",
                                                   "\u003cpassword\u003e",
                                                   "redacted"
                                               ],
                      "recommendation":  "Credentials should never be hardcoded. Use environment variables or a secrets manager."
                  },
                  {
                      "id":  "VZS002",
                      "name":  "Dynamic Code Execution",
                      "applies_to":  [
                                         "javascript",
                                         "typescript"
                                     ],
                      "severity":  "medium",
                      "keywords":  [
                                       "eval("
                                   ],
                      "pattern":  "\\beval\\s*\\(",
                      "recommendation":  "eval() executes arbitrary code. Avoid if possible or validate input strictly."
                  },
                  {
                      "id":  "VZS003",
                      "name":  "Function Constructor",
                      "applies_to":  [
                                         "javascript",
                                         "typescript"
                                     ],
                      "severity":  "medium",
                      "keywords":  [
                                       "function("
                                   ],
                      "pattern":  "(?:\\bnew\\s+Function\\s*\\(|(?\u003c![A-Za-z0-9_])Function\\s*\\()",
                      "recommendation":  "Function constructor is similar to eval(). Consider alternatives."
                  },
                  {
                      "id":  "VZS004",
                      "name":  "Command Execution",
                      "applies_to":  [
                                         "javascript",
                                         "typescript"
                                     ],
                      "severity":  "medium",
                      "keywords":  [
                                       "child_process",
                                       "execsync",
                                       "execfile"
                                   ],
                      "pattern":  "(?:\\bchild_process\\b|\\bexecSync\\s*\\(|\\bexecFile(?:Sync)?\\s*\\(|\\bspawnSync?\\s*\\()",
                      "recommendation":  "Shell command execution detected. Ensure input is sanitized to prevent injection."
                  },
                  {
                      "id":  "VZS005",
                      "name":  "Debug Statements",
                      "applies_to":  [
                                         "javascript",
                                         "typescript"
                                     ],
                      "severity":  "low",
                      "keywords":  [
                                       "console."
                                   ],
                      "pattern":  "\\bconsole\\.(?:log|debug|info)\\(",
                      "count_min":  4,
                      "skip_in_tests":  true,
                      "recommendation":  "Multiple console statements found. Remove before production."
                  },
                  {
                      "id":  "VZS006",
                      "name":  "TODO/FIXME Comments",
                      "applies_to":  [
                                         "*"
                                     ],
                      "severity":  "low",
                      "keywords":  [
                                       "todo",
                                       "fixme",
                                       "hack",
                                       "xxx"
                                   ],
                      "pattern":  "\\b(?:TODO|FIXME|HACK|XXX)\\b",
                      "count_min":  5,
                      "skip_in_tests":  true,
                      "recommendation":  "Multiple TODO/FIXME comments found. Address before release."
                  },
                  {
                      "id":  "VZS010",
                      "name":  "Weak Hash Algorithm",
                      "applies_to":  [
                                         "python",
                                         "javascript",
                                         "typescript",
                                         "go",
                                         "java",
                                         "csharp"
                                     ],
                      "severity":  "medium",
                      "keywords":  [
                                       "md5",
                                       "sha1",
                                       "createhash"
                                   ],
                      "pattern":  "(?:hashlib\\.(?:md5|sha1)\\s*\\(|hashlib\\.new\\(\\s*[\u0027\"](?:md5|sha1)[\u0027\"]|crypto\\.createHash\\(\\s*[\u0027\"](?:md5|sha1)[\u0027\"]\\)|md5\\.New\\(|sha1\\.New\\(|MessageDigest\\.getInstance\\(\\s*\"(?:MD5|SHA-?1)\")",
                      "recommendation":  "MD5 and SHA-1 are cryptographically broken. Use SHA-256 or stronger."
                  },
                  {
                      "id":  "VZS011",
                      "name":  "AWS Access Key",
                      "applies_to":  [
                                         "*"
                                     ],
                      "severity":  "high",
                      "keywords":  [
                                       "akia",
                                       "asia",
                                       "abia",
                                       "acca"
                                   ],
                      "pattern":  "\\b((?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16})\\b",
                      "entropy_capture_group":  1,
                      "entropy_min":  3.0,
                      "allowlist_substrings":  [
                                                   "example",
                                                   "xxxxxx",
                                                   "0000000000000000"
                                               ],
                      "recommendation":  "AWS access key found in source. Rotate immediately and store in environment variables or AWS Secrets Manager."
                  },
                  {
                      "id":  "VZS012",
                      "name":  "GitHub Token",
                      "applies_to":  [
                                         "*"
                                     ],
                      "severity":  "high",
                      "keywords":  [
                                       "ghp_",
                                       "gho_",
                                       "ghu_",
                                       "ghs_",
                                       "ghr_"
                                   ],
                      "pattern":  "\\b(gh[pousr]_[A-Za-z0-9]{36,255})\\b",
                      "entropy_capture_group":  1,
                      "entropy_min":  3.0,
                      "recommendation":  "GitHub token found in source. Rotate via GitHub settings and store in environment variables."
                  },
                  {
                      "id":  "VZS013",
                      "name":  "Private Key Block",
                      "applies_to":  [
                                         "*"
                                     ],
                      "severity":  "high",
                      "keywords":  [
                                       "private key"
                                   ],
                      "pattern":  "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
                      "recommendation":  "Private key material in source. Move to a secrets manager and rotate the key."
                  },
                  {
                      "id":  "VZS014",
                      "name":  "TLS Verification Disabled",
                      "applies_to":  [
                                         "python",
                                         "javascript",
                                         "typescript",
                                         "go"
                                     ],
                      "severity":  "high",
                      "keywords":  [
                                       "verify=false",
                                       "rejectunauthorized",
                                       "insecureskipverify"
                                   ],
                      "pattern":  "(?:\\bverify\\s*=\\s*False\\b|rejectUnauthorized\\s*:\\s*false|InsecureSkipVerify\\s*:\\s*true)",
                      "recommendation":  "TLS certificate verification disabled. This allows man-in-the-middle attacks. Re-enable verification."
                  },
        {
            "id": "VZS051",
            "name": "AWS Secret Access Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["aws_secret", "awssecret", "secretaccesskey"],
            "pattern": "(?i)aws[_\\-]?secret[_\\-]?(?:access[_\\-]?)?key\\s*[=:]\\s*['\"]?([A-Za-z0-9/+=]{40})(?=['\"]|\\s|$|,)",
            "entropy_capture_group": 1,
            "entropy_min": 4.0,
            "deny_substrings_in_line": ["process.env", "os.environ", "getenv", "system.getenv", "deno.env", "import.meta.env"],
            "allowlist_substrings": ["example", "your-", "your_", "placeholder", "xxxxxx", "redacted", "wjalrxutnfemi/k7mdeng"],
            "recommendation": "AWS secret access key found in source. Rotate immediately and use IAM roles or AWS Secrets Manager."
        },
        {
            "id": "VZS052",
            "name": "GCP Service Account Credentials",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["service_account"],
            "pattern": "\"type\"\\s*:\\s*\"service_account\"[^\\n]{0,500}\"private_key\"",
            "recommendation": "GCP service account JSON in source. Move to a secrets manager and revoke the leaked key in IAM."
        },
        {
            "id": "VZS053",
            "name": "GCP API Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["aiza"],
            "pattern": "\\b(AIza[0-9A-Za-z_\\-]{35})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.0,
            "allowlist_substrings": ["example", "your-", "placeholder", "xxxxxx"],
            "recommendation": "GCP API key in source. Restrict the key in GCP console and store via environment variables."
        },
        {
            "id": "VZS054",
            "name": "Azure Storage Account Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["accountkey="],
            "pattern": "AccountKey\\s*=\\s*([A-Za-z0-9+/=]{60,100})(?=;|\"|'|\\s|$)",
            "entropy_capture_group": 1,
            "entropy_min": 4.0,
            "deny_substrings_in_line": ["process.env", "os.environ", "getenv", "system.getenv"],
            "allowlist_substrings": ["example", "your", "placeholder", "xxxxxx", "redacted"],
            "recommendation": "Azure Storage AccountKey in source. Rotate the key and switch to managed identity or Key Vault."
        },
        {
            "id": "VZS055",
            "name": "Slack Token",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["xoxb-", "xoxp-", "xoxa-", "xoxr-", "xoxs-"],
            "pattern": "\\b(xox[baprs]-[A-Za-z0-9\\-]{10,})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.0,
            "allowlist_substrings": ["example", "your-", "xxxxxx", "redacted"],
            "recommendation": "Slack token in source. Revoke immediately in Slack admin and store new token in environment variables."
        },
        {
            "id": "VZS056",
            "name": "Slack Webhook URL",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["hooks.slack.com"],
            "pattern": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]{20,}",
            "allowlist_substrings": ["example", "your", "redacted", "xxxxxx"],
            "recommendation": "Slack webhook URL in source. Anyone with this URL can post to the channel; rotate and treat as a secret."
        },
        {
            "id": "VZS057",
            "name": "Stripe Live Secret Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["sk_live_", "rk_live_"],
            "pattern": "\\b((?:sk|rk)_live_[0-9a-zA-Z]{20,})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.5,
            "allowlist_substrings": ["example", "your-", "xxxxxx", "redacted"],
            "recommendation": "Stripe live secret key in source. Rotate immediately in the Stripe dashboard."
        },
        {
            "id": "VZS058",
            "name": "SendGrid API Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["sg."],
            "pattern": "\\b(SG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.5,
            "allowlist_substrings": ["example", "your", "placeholder", "redacted"],
            "recommendation": "SendGrid API key in source. Revoke in SendGrid console and reissue via secrets manager."
        },
        {
            "id": "VZS059",
            "name": "Twilio API Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["twilio"],
            "pattern": "\\b(SK[0-9a-fA-F]{32})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.0,
            "allowlist_substrings": ["example", "your", "redacted", "xxxxxx"],
            "recommendation": "Twilio API key in source. Rotate from the Twilio console and store via environment variables."
        },
        {
            "id": "VZS060",
            "name": "npm Auth Token",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["npm_"],
            "pattern": "\\b(npm_[A-Za-z0-9]{36})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.5,
            "allowlist_substrings": ["example", "your-", "placeholder", "redacted"],
            "recommendation": "npm publish token in source. Revoke at npmjs.com → Access Tokens; never commit ~/.npmrc."
        },
        {
            "id": "VZS061",
            "name": "PyPI Upload Token",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["pypi-ageicHlwaS5vcmc", "pypi-"],
            "pattern": "\\b(pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_\\-]{50,})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.5,
            "recommendation": "PyPI upload token in source. Revoke at pypi.org → Account Settings → API tokens."
        },
        {
            "id": "VZS062",
            "name": "GitLab Personal Access Token",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["glpat-"],
            "pattern": "\\b(glpat-[A-Za-z0-9_\\-]{20})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.0,
            "allowlist_substrings": ["example", "your", "redacted", "xxxxxx"],
            "recommendation": "GitLab personal access token in source. Revoke at GitLab → Preferences → Access Tokens."
        },
        {
            "id": "VZS063",
            "name": "Discord Bot Token",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["discord"],
            "pattern": "\\b([MN][A-Za-z\\d]{23}\\.[\\w\\-]{6}\\.[\\w\\-]{27})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.5,
            "allowlist_substrings": ["example", "your", "redacted"],
            "recommendation": "Discord bot token in source. Reset the bot token in the Developer Portal immediately."
        },
        {
            "id": "VZS064",
            "name": "OpenAI API Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["sk-proj-", "openai"],
            "pattern": "\\b(sk-(?:proj-|svcacct-)?[A-Za-z0-9_\\-]{40,})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 4.0,
            "deny_substrings_in_line": ["process.env", "os.environ", "getenv", "deno.env", "import.meta.env"],
            "allowlist_substrings": ["example", "your-", "placeholder", "redacted", "xxxxxx", "sk-ant-", "sk_live_", "sk_test_"],
            "recommendation": "OpenAI API key in source. Rotate at platform.openai.com → API keys and load from env."
        },
        {
            "id": "VZS065",
            "name": "Anthropic API Key",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["sk-ant-"],
            "pattern": "\\b(sk-ant-(?:api|sid)\\d{2}-[A-Za-z0-9_\\-]{80,})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 4.0,
            "deny_substrings_in_line": ["process.env", "os.environ", "getenv", "deno.env"],
            "allowlist_substrings": ["example", "your-", "placeholder", "redacted", "xxxxxx"],
            "recommendation": "Anthropic API key in source. Rotate at console.anthropic.com → API keys and load from env."
        },
        {
            "id": "VZS066",
            "name": "HuggingFace Access Token",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["hf_"],
            "pattern": "\\b(hf_[A-Za-z0-9]{34})\\b",
            "entropy_capture_group": 1,
            "entropy_min": 3.0,
            "allowlist_substrings": ["example", "your", "placeholder", "redacted"],
            "recommendation": "HuggingFace token in source. Revoke at huggingface.co → Settings → Access Tokens."
        },
        {
            "id": "VZS067",
            "name": "Alternate Private Key Format",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["age-secret-key", "putty-user-key"],
            "pattern": "(?:AGE-SECRET-KEY-1[A-Z0-9]{20,}|PuTTY-User-Key-File-[2-9])",
            "recommendation": "Private key material in source (age or PuTTY format). Move to a secrets manager and rotate the key."
        },
        {
            "id": "VZS068",
            "name": "Database URL With Embedded Password",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["postgres://", "mysql://", "mongodb://", "mongodb+srv://", "redis://", "mariadb://", "amqp://"],
            "pattern": "\\b(?:postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|mariadb|amqp)://[A-Za-z0-9._~\\-%]+:([^@\\s/'\"<>]{4,})@[A-Za-z0-9._\\-]+",
            "entropy_capture_group": 1,
            "entropy_min": 2.0,
            "deny_substrings_in_line": ["process.env", "os.environ", "getenv", "system.getenv", "deno.env"],
            "allowlist_substrings": ["password", "your_", "your-", "placeholder", "changeme", "redacted", "%s", "%25s", "${", "<password>", "xxxxxx"],
            "recommendation": "Database URL contains an embedded password. Move credentials to environment variables or a secrets manager."
        },
        {
            "id": "VZS069",
            "name": "JDBC Connection String With Password",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["jdbc:"],
            "pattern": "(?i)jdbc:[a-z0-9:]+://[^\\s'\"<>]+[?;&]password=([^&\\s'\"<>]{4,})",
            "entropy_capture_group": 1,
            "entropy_min": 2.0,
            "deny_substrings_in_line": ["system.getenv", "process.env", "getenv"],
            "allowlist_substrings": ["password", "your_", "placeholder", "changeme", "redacted", "${", "<password>"],
            "recommendation": "JDBC URL has password= inline. Use a properties file outside source control or a vault."
        },
        {
            "id": "VZS070",
            "name": "Basic Auth Credentials In URL",
            "applies_to": ["*"],
            "severity": "high",
            "keywords": ["http://", "https://"],
            "pattern": "\\bhttps?://[A-Za-z0-9._~\\-]+:([^@\\s/'\"<>]{4,})@[A-Za-z0-9._\\-]+",
            "entropy_capture_group": 1,
            "entropy_min": 2.0,
            "deny_substrings_in_line": ["process.env", "os.environ", "getenv", "deno.env"],
            "allowlist_substrings": ["password", "your_", "your-", "placeholder", "changeme", "redacted", "${", "<password>", "%s", "example.com"],
            "recommendation": "HTTP basic-auth credentials embedded in a URL. Strip credentials and pass them via Authorization headers."
        }
              ]
}
