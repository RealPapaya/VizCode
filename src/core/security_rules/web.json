{
  "schema_rev": 1,
  "rules": [
    {
      "id": "VZS020",
      "name": "SQL Injection Risk",
      "applies_to": ["python", "javascript", "typescript", "java", "csharp", "php"],
      "severity": "high",
      "keywords": ["query(", "execute(", "rawquery", "raw_sql"],
      "pattern": "(?:query|execute|rawQuery|raw_sql)\\s*\\(\\s*['\"`][^'\"`]*(?:\\s*\\+|\\$\\{)[^'\"`]*(?:SELECT|INSERT|UPDATE|DELETE|FROM|WHERE)",
      "recommendation": "String concatenation in SQL queries. Use parameterized queries instead.",
      "source": "CodeFlow"
    },
    {
      "id": "VZS022",
      "name": "XSS via dangerouslySetInnerHTML",
      "applies_to": ["javascript", "typescript"],
      "severity": "high",
      "keywords": ["dangerouslysetinnerhtml"],
      "pattern": "\\bdangerouslySetInnerHTML\\b",
      "recommendation": "React's dangerouslySetInnerHTML bypasses XSS protection. Sanitize HTML before injecting.",
      "source": "CodeFlow / njsscan"
    },
    {
      "id": "VZS023",
      "name": "JWT Token Literal",
      "applies_to": ["*"],
      "severity": "high",
      "keywords": ["eyj"],
      "pattern": "\\b(eyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,})\\b",
      "entropy_capture_group": 1,
      "entropy_min": 3.5,
      "recommendation": "JWT token literal in source. Store tokens server-side and never commit them.",
      "source": "Gitleaks jwt"
    }
  ]
}
